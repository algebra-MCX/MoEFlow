logs/

# Runtime logs and local history backups stay on this machine.
*.log
*.log.*
*.out
*.err
logs/
.history-backup/
.clean-checkouts/

# Personal configuration and credentials.
.env
.env.*
!.env.example
.aws/
.ssh/
*.pem
*.key

# Raw measurement outputs stay local; docs cite them by path.
results/

# Internal project instructions stay local.
CLAUDE.md
PROJECT.md

# Documentation is published separately once reorganised.
docs/
